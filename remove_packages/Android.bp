// The retrofit super on beryllium (system 3 GiB + vendor 1 GiB + cust 832 MiB)
// is fixed in size, and a DerpFest build with the full GMS set does not fit
// even with shared ext4 blocks (~283 MiB over). Drop the Google app (Velvet,
// ~337 MiB): it is the largest single package and installs from the Play Store.
//
// Velvet is a Soong module (android_app_import), so a Make phony package with
// LOCAL_OVERRIDES_PACKAGES does not remove it; an installed Soong module with
// `overrides` does. Same pattern as DerpFestRemovePackages in vendor/lineage.
cc_prebuilt_binary {
    name: "BerylliumRemovePackages",
    overrides: [
        "Velvet",
    ],
    strip: {
        none: true,
    },
    srcs: ["BerylliumRemovePackages"],
}
